[claude-code][in] {"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"team_board","description":"直接读写小组任务板：建小组/查小组/查任务/加任务/标记完成/领取任务/看统计和事件流。什么时候用：你要把长任务记下来防止遗漏、查看别人做到哪了、或者把某条任务标成完成/失败。第一次用并且还没有小组时，先用 action:\"create\" 建一个小组（会返回 teamId），之后动作都要带这个 teamId。需要真正执行任务的请用 super_agent / team_orchestrate；本工具只负责记账。","inputSchema":{"type":"object","properties":{"action":{"type":"string","description":"list=看任务（默认）；add=加任务；done=标完成；fail=标失败；claim=领取；next=取我的下一条；stats=看统计；events=看事件流；create=新建小组；teams=列出所有小组。","enum":["list","add","done","fail","claim","next","stats","events","create","teams"]},"teamId":{"type":"string","description":"小组 id（可选，默认当前小组）。"},"taskId":{"type":"string","description":"任务 id（done/fail/claim 时必填）。"},"title":{"type":"string","description":"任务标题（add 时必填）。"},"name":{"type":"string","description":"小组名（create 时必填）。"},"goal":{"type":"string","description":"小组目标（create 时填写，便于之后找回上下文）。"},"members":{"type":"array","items":{"type":"string"},"description":"建组时一并加入的成员名（create 时可选）。"},"role":{"type":"string","description":"负责角色：lead|architect|critic|worker|tester|scribe。"},"acceptance":{"type":"string","description":"验收标准（add 时强烈建议填写）。"},"dependsOn":{"type":"array","items":{"type":"string"},"description":"依赖的任务 id。"},"output":{"type":"string","description":"完成说明/产出摘要（done 时填写）。"},"note":{"type":"string","description":"补充说明或失败原因。"},"memberId":{"type":"string","description":"领取/查询时指定成员 id。"},"status":{"type":"string","description":"list 时按状态过滤：todo|doing|done|failed。"},"limit":{"type":"number","description":"events 最多显示几条，默认 20。"}},"required":[]}},{"name":"agent_join","description":"管理小组的人：查看当前成员、把某个本地 CLI Agent（claude/codex/dsh 等）拉进小组、移出成员、把任务指派给某人。什么时候用：用户想\"加人/换人/看有谁/指定谁来做\"，或者你想确认某角色有没有可用成员时。注意：它不执行任务；要真正干活请用 team_orchestrate（并行分工）或 super_agent（自己动手）。","inputSchema":{"type":"object","properties":{"action":{"type":"string","description":"list=看成员（默认）；join=拉人进来；leave=移出；assign=指派任务；capabilities=看某成员能力。","enum":["list","join","leave","assign","capabilities"]},"name":{"type":"string","description":"成员名字/标识（join 时必填；leave/assign/capabilities 时用于定位成员）。"},"role":{"type":"string","description":"成员角色：lead|architect|critic|worker|tester|scribe。"},"agent":{"type":"string","description":"本地 CLI 预设或可执行命令，例如 claude / codex / dsh / gemini。"},"capabilities":{"type":"array","items":{"type":"string"},"description":"能力标签，例如 [\"node\",\"python\",\"写文档\"]。"},"teamId":{"type":"string","description":"小组 id（可选，默认当前小组）。"},"taskId":{"type":"string","description":"assign 时要指派的任务 id。"}},"required":[]}},{"name":"team_orchestrate","description":"把一个大目标拆成分工明确的子任务，派给小组里的多个成员并行完成，并对每条产出做验收。什么时候用：需求能自然拆成 2 个以上可并行的子任务（\"前后端一起改\"\"三个人分别查三个模块\"）。单个目标只需一个人干完，请用 super_agent（更省 token）；只想先看拆解结果不想执行，传 dryRun:true。","inputSchema":{"type":"object","properties":{"goal":{"type":"string","description":"总目标：写清要交付什么、验收标准是什么。"},"brief":{"type":"string","description":"补充上下文/约束/已知信息（可选）。"},"teamId":{"type":"string","description":"在哪个小组里编排（可选，默认当前小组）。"},"maxTasks":{"type":"number","description":"最多拆多少条任务，默认 8。"},"concurrency":{"type":"number","description":"同时最多跑几条任务，默认 3。"},"dryRun":{"type":"boolean","description":"true = 只出计划不执行。"},"plan":{"type":"array","description":"直接用你给的任务数组，跳过模型拆解（每项：id/title/role/acceptance/dependsOn）。","items":{"type":"object","properties":{"id":{"type":"string"},"title":{"type":"string"},"role":{"type":"string"},"acceptance":{"type":"string"},"dependsOn":{"type":"array","items":{"type":"string"}}},"required":["title"]}}},"required":["goal"]}},{"name":"super_agent","description":"让超级 Agent 自主完成一件真实工作（读/写文件、执行命令、查资料、更新任务板），不需要你先拆步骤。什么时候用：用户给了一个需要动手的目标（\"修好这个 bug\"\"把项目跑起来\"\"查一下这个库怎么用并写个示例\"），而你要的是一份带执行轨迹的结果报告。只想看计划不执行，请用 team_orchestrate 并传 dryRun:true。","inputSchema":{"type":"object","properties":{"goal":{"type":"string","description":"要完成的目标，写清背景和期望结果（越具体越好）。"},"context":{"type":"string","description":"已知信息/约束/相关文件路径（可选）。"},"workspace":{"type":"string","description":"工作区绝对路径（可选，默认用插件配置的工作区）。"},"maxSteps":{"type":"number","description":"最多执行多少步思考-行动循环，默认 12，上限 25。"},"tools":{"type":"array","description":"限制可用工具（可选，例如 [\"fs_read\",\"shell\"]）。","items":{"type":"string"}},"teamId":{"type":"string","description":"把执行过程记录到哪个小组的任务板（可选）。"}},"required":["goal"]}},{"name":"deck_room","description":"跨机协作房间：create=建房间并拿到可微信发出去的邀请链接（装 DSH 的深链 + 没装 DSH 的网页加入页），join=用邀请链接/房间号进房间，sync=把本地任务推上去并拉回别人的任务（报告\"推上去 N 条、拉回来 M 条\"），info=看房间成员，close=房主关房，leave=退出房间。什么时候用：用户说\"和同事一起干活/让另一台机器加入/把任务同步过去\"。单人单机不需要这个工具。","inputSchema":{"type":"object","properties":{"action":{"type":"string","enum":["create","join","sync","info","close","leave"],"description":"动作：create / join / sync / info / close / leave。"},"name":{"type":"string","description":"建房时的房间名（如\"支付重构\"）；不填用默认名字。"},"inviteUrl":{"type":"string","description":"join 时贴完整邀请链接（dsh://agentdeck/join?room=…&t=… 或 relay 给的网页加入页链接都行）。"},"roomId":{"type":"string","description":"房间号（join 时和 inviteToken 一起用；sync/info/close/leave 可省略，默认用当前房间）。"},"inviteToken":{"type":"string","description":"邀请码（join 时和 roomId 一起用）。"},"waitSec":{"type":"number","description":"sync 时最多长轮询多少秒（0-30，默认 0 立即返回；等别人时给 10）。"},"teamId":{"type":"string","description":"把这个小组的任务板接到房间；不填用默认小组。"}},"required":["action"]}},{"name":"deck_license","description":"查询或激活 agentdeck-super 的授权：status=当前档位/到期/席位（默认），plans=四档价格，activate=写入授权码并校验。什么时候用：用户问\"我现在是什么版本/怎么升级/到期了吗\"，或者用户把一串授权码贴给你让你启用。免费版不写授权码也能用全部单机功能；本工具不会因为授权缺失而报错。","inputSchema":{"type":"object","properties":{"action":{"type":"string","enum":["status","plans","activate"],"description":"status=看当前档位（默认）；plans=看价格表；activate=写入授权码。"},"key":{"type":"string","description":"授权码（activate 时必填，整串字母数字，不要带引号）。"}},"required":[]}},{"name":"pet_visit","description":"桌宠串门：生成邀请函、收邀请、互留便签。action=card 看自己的名片；invite 生成一条 dsh://agentdeck/visit 邀请链接；accept 收下别人的邀请（需要 token）；gift 送礼物便签；ask 留求助便签（会变成一条任务）；receive 把收到的便签落到任务板；log 看最近的串门记录。跨机器全靠你把返回的链接/便签 JSON 复制给对方，本工具不会自己联网、不会开服务。","inputSchema":{"type":"object","properties":{"action":{"type":"string","enum":["card","invite","accept","gift","ask","receive","log"],"description":"要做什么，默认 card。"},"ttlHours":{"type":"number","description":"invite：邀请有效期（小时），默认 24，最多 720。"},"scope":{"type":"string","enum":["visit","work"],"description":"invite：visit=只串门（默认），work=可以给我派活。"},"reply":{"type":"string","description":"invite：可选的回执地址（http/https），对方收下时会把名片回给你。"},"token":{"type":"string","description":"accept：邀请链接里的凭证（t= 后面那一串）。"},"expectedScope":{"type":"string","enum":["visit","work"],"description":"accept：只接受这个范围的邀请。"},"message":{"type":"string","description":"gift：附言。"},"skin":{"type":"string","description":"gift：送哪套皮肤（id）。"},"title":{"type":"string","description":"ask：求助标题（会变成任务标题）。"},"acceptance":{"type":"string","description":"ask：验收标准。"},"role":{"type":"string","description":"ask：希望谁来接（worker / tester / reviewer…）。"},"note":{"type":"string","description":"ask / receive：补充说明；receive 时也可以直接给便签对象。"},"to":{"type":"string","description":"gift / ask：写给谁。"},"teamId":{"type":"string","description":"receive：落到哪个队（只有一个队时可省略）。"},"limit":{"type":"number","description":"log：看最近几条，默认 10。"}},"required":[]}},{"name":"pet_meeting","description":"让桌宠替你开一场团队会议：主持人开场 → 每个成员带着自己的画像轮流发言 → 收敛成严格 JSON 的结论 → 决议写成中文纪要、任务直接进任务板。什么时候用：用户说\"开个会/讨论一下/帮我把这件事拆成任务\"，或者一个目标需要多个角色一起拆解时。依赖宿主的 chat 能力；没有模型时如实失败，不会往任务板里塞半成品。","inputSchema":{"type":"object","properties":{"teamId":{"type":"string","description":"在哪个队开会（只有一个队时可省略）。"},"topic":{"type":"string","description":"会议议题（必填）。"},"rounds":{"type":"number","description":"发言轮次，1~5，默认 2。"},"maxTasks":{"type":"number","description":"最多拆出几个任务，1~20，默认 5。"},"participants":{"type":"array","description":"参与人（可选）。不给就用队伍成员。每人 { memberId, name, role, personaHint }。","items":{"type":"object","properties":{"memberId":{"type":"string"},"name":{"type":"string"},"role":{"type":"string"},"personaHint":{"type":"string"}},"required":["name"]}}},"required":["topic"]}},{"name":"pet_skin","description":"桌宠外观：列皮肤、查授权、换皮肤、看五种状态。action=list 列出可用皮肤（默认）；activate 换装（id=皮肤 id 或中文名）；states 看 idle/working/meeting/visiting/sleeping 五种状态；render 出一张 SVG 字符串（给宿主/界面用）。免费皮肤永远可用；付费皮肤没有授权会明确拒绝并报价，绝不偷偷换成别的皮肤。","inputSchema":{"type":"object","properties":{"action":{"type":"string","enum":["list","activate","states","render"],"description":"要做什么，默认 list。"},"id":{"type":"string","description":"activate / render：皮肤 id 或名字（如 basic / 霓虹）。"},"state":{"type":"string","enum":["idle","working","meeting","visiting","sleeping"],"description":"render：状态，默认 idle。"},"size":{"type":"number","description":"render：边长像素，24~512，默认 96。"}},"required":[]}},{"name":"twin_remember","description":"把一件值得记住的事写进「数字分身」的本地记忆：用户偏好、项目事实、谁是谁、干过什么、聊出来的结论。什么时候用：用户说\"记住…\"、你发现一条以后还会用到的约束、或一次任务干完要留结论。五类：session=会话、event=事件、semantic=语义、preference=偏好、relation=关系。四级可见性（默认 private，永不出本机）：private=私有、friend=好友、room=房间、public=公开。它只写本机文件，不联网、不上传；重复的同一句会自动合并，不会刷屏。","inputSchema":{"type":"object","properties":{"text":{"type":"string","description":"要记的内容，一句话说清（中文原文最好，别改写成书面语）。"},"type":{"type":"string","enum":["session","event","semantic","preference","relation"],"description":"记忆类型，默认 event。session=会话、event=事件、semantic=语义、preference=偏好、relation=关系"},"tags":{"type":"array","items":{"type":"string"},"description":"标签，最多 6 个，例如 [\"报销\",\"财务\"]。"},"visibility":{"type":"string","enum":["private","friend","room","public"],"description":"可见性，默认 private。private=私有、friend=好友、room=房间、public=公开"},"source":{"type":"string","description":"谁写的：用户原话写 user，自己推出来的写 agent，工具产出写 tool。"},"pinned":{"type":"boolean","description":"钉住：清理超量记忆时优先保留它。"}},"required":["text"]}},{"name":"twin_recall","description":"从数字分身记忆里召回相关的几条：给关键词、给类型、或给标签都行。可见性闸门：默认 audience=private（本人，全都能看）；要发给别人就先降到 friend / room / public 自己能看的那部分。什么时候用：动手前先查\"用户以前怎么要求的\"\"这个项目有什么约定\"，别问第二遍。","inputSchema":{"type":"object","properties":{"query":{"type":"string","description":"关键词，中文原词即可（按字面 + 二元组匹配，不做分词）。"},"type":{"type":"string","enum":["session","event","semantic","preference","relation"],"description":"只召回某一类。"},"tags":{"type":"array","items":{"type":"string"},"description":"按标签过滤（命中加分，不是硬过滤）。"},"limit":{"type":"number","description":"最多几条，默认 5，上限 50。"},"audience":{"type":"string","enum":["private","friend","room","public"],"description":"谁在看：private=本人（默认，全部可见）、friend=好友、room=房间、public=陌生人。"},"maxVisibility":{"type":"string","enum":["private","friend","room","public"],"description":"audience 的旧名，等价。"},"any":{"type":"boolean","description":"true=不按相关度过滤，直接把可见的几条带出来（\"我记了什么\"时用）。"}},"required":[]}},{"name":"twin_brief","description":"生成一段「你是我的数字分身」简报：确认过的习惯 + 各类记忆 + 任务板概况，可直接塞进提示词当上下文。什么时候用：换了个 Agent、换了个宿主、或新开一轮会话，需要快速把这个人的做事方式补齐。shareable:true 时另给一份可以发给别人的版本（只含非私有记忆）。","inputSchema":{"type":"object","properties":{"limit":{"type":"number","description":"每类记忆最多几条，默认 3。"},"audience":{"type":"string","enum":["private","friend","room","public"],"description":"谁在看：默认 private=本人（全部可见）；对外发就先降到 friend/public。"},"allowShare":{"type":"boolean","description":"同时生成对外可发摘要。"}},"required":[]}},{"name":"twin_forget","description":"删记忆：按 id 删、按关键词/标签批量删、all:true 清空（必须带 confirm:true）。什么时候用：用户说\"忘了这件事\"\"这些别记\"\"清空记忆\"。删之前会先留一份 .bak，防手抖。导出可以用 action=export（拿到 json 或 md 文本，自己决定发不发）。","inputSchema":{"type":"object","properties":{"action":{"type":"string","enum":["forget","export","stats"],"description":"默认 forget；export=导出；stats=看统计。"},"id":{"type":"string","description":"按记忆 id 精确删。"},"query":{"type":"string","description":"按关键词删（召回命中的都删）。"},"tag":{"type":"string","description":"按标签删。"},"all":{"type":"boolean","description":"true=清空全部（必须同时 confirm:true）。"},"confirm":{"type":"boolean","description":"清空时的二次确认。"},"format":{"type":"string","enum":["json","md"],"description":"export 的格式，默认 json。"}},"required":[]}},{"name":"twin_habit","description":"桌宠习惯的明面管理：propose=看候选（只读）、confirm=确认（会真正学进画像）、reject=以后别问、rollback=撤回。自动学习只会\"悄悄升级\"；这个工具让用户能看见、能点头、能反悔——这是\"数字分身进化\"必须留的刹车。","inputSchema":{"type":"object","properties":{"action":{"type":"string","enum":["propose","list","confirm","reject","rollback"],"description":"propose=看候选；confirm=确认；reject=拒绝；rollback=撤回；list=看已确认的。"},"key":{"type":"string","description":"候选的 key（propose 会给），也可以用候选序号 \"1\"。"},"all":{"type":"boolean","description":"rollback 时 true=撤回全部。"},"force":{"type":"boolean","description":"rollback 时 true=连自动学出来的也一起撤。"}},"required":["action"]}},{"name":"deck_meeting","description":"跨厂商会议：让 Claude / Codex / DSH 这些不同 Agent 把意见写进同一份会议纪要，结会时把决议拆成任务进任务板。open=开会（topic 必填，participants 可给名字或 {name,vendor}）；submit=发言（meetingId + text，from/vendor/stance 可选）；conclude=结会（decision 必填，tasks 数组会真写进任务板）；show=看纪要；list=看开过哪些会。和自己脑内讨论的区别：每条意见都来自真实进程，原样落盘、可追责，不经过模型改写。","inputSchema":{"type":"object","properties":{"action":{"type":"string","enum":["open","submit","conclude","show","list"],"description":"open/submit/conclude/show/list，默认 list。"},"topic":{"type":"string","description":"open：议题。"},"goal":{"type":"string","description":"open：这场会要解决什么。"},"participants":{"type":"array","items":{"type":"string"},"description":"open：参与人名字（也可写 \"Claude:claude-code\" 这种 名字:厂商）。"},"meetingId":{"type":"string","description":"submit/conclude/show：会议号。"},"from":{"type":"string","description":"submit：谁在发言（Agent 名/人名）。"},"vendor":{"type":"string","description":"submit：哪个厂商的 Agent（claude/codex/dsh/gemini…）。"},"stance":{"type":"string","enum":["支持","反对","补充"],"description":"submit：态度。"},"text":{"type":"string","description":"submit：发言内容。"},"decision":{"type":"string","description":"conclude：最终决议（中文一段话）。"},"tasks":{"type":"array","items":{"type":"object","properties":{"title":{"type":"string"},"role":{"type":"string"},"acceptance":{"type":"string"}},"required":["title"]},"description":"conclude：要拆出来的任务。"},"teamId":{"type":"string","description":"conclude：任务落到哪个小组（不填=唯一的小组）。"}},"required":[]}},{"name":"deck_automation","description":"定时任务 + 人工审批 + 全局停止：让事情到点自己发生，或者到点先问你一声。add=加一条（every:\"30m\" 周期 或 at:\"2026-11-05T20:00:00+08:00\" 一次性；action:\"task\" 丢任务到任务板，action:\"agent\" 真跑一次 Agent；needsApproval:true 则到点只进审批队列）list=看全部；run=立刻跑一次；approve/deny=放行或拒绝待审批；stop/resume=全局停止/恢复；status=一眼看住。stop 是落盘的：命令行 `nexi stop` 也能停住正在跑的宿主。","inputSchema":{"type":"object","properties":{"action":{"type":"string","enum":["add","list","remove","run","approve","deny","stop","resume","status"],"description":"add/list/remove/run/approve/deny/stop/resume/status。默认 status。"},"title":{"type":"string","description":"add：任务标题（人话，会出现在任务板上）。"},"every":{"type":"string","description":"add：周期，如 \"30s\"/\"10m\"/\"2h\"/\"1d\"。"},"at":{"type":"string","description":"add：一次性时间，ISO 带时区，如 2026-11-05T20:00:00+08:00。"},"kind":{"type":"string","enum":["task","agent"],"description":"add：执行方式，默认 task（丢任务到任务板）。"},"acceptance":{"type":"string","description":"add：验收标准（会写进任务）。"},"role":{"type":"string","description":"add：任务角色，默认 worker。"},"teamId":{"type":"string","description":"add：落到哪个小组（不填=唯一的小组）。"},"prompt":{"type":"string","description":"add+kind:agent：到点让 Agent 干什么。"},"agent":{"type":"string","description":"add+kind:agent：用哪个 Agent（claude/codex/dsh…）。"},"needsApproval":{"type":"boolean","description":"add：true=到点只进审批队列，人点头才真干。"},"maxRuns":{"type":"number","description":"add：最多跑几次。"},"jobId":{"type":"string","description":"remove/run：哪一条定时任务。"},"approvalId":{"type":"string","description":"approve/deny：哪一条待审批。"},"reason":{"type":"string","description":"stop/deny：原因（会记录）。"},"limit":{"type":"number","description":"list：最多显示几条，默认 20。"}},"required":[]}}]}}
