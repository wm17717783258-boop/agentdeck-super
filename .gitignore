# 依赖
node_modules/
pnpm-lock.yaml

# 打包产物
*.tgz
*.log

# 本地密钥（绝不提交）
.secrets/

# 内部资料（定价 / 变现 / 竞品 / 发布手册）：只留本地，不进开源仓库
internal/

# 运行时数据（每个用户自己的）
.relay-data/
.agentdeck/
.agentdeck-issuer/
policy.json
audit.jsonl
market/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 证据与临时
tmp/
*.tmp
.tmp-*
nexi-pair/
.nexi-pair/

# 证据日志：含真实内网地址、房间 token、机器指纹
# 绝不入库、也绝不进发布包（package.json files 里另有 !docs/evidence）
docs/evidence/

# 历史验证解包副本（内含完整 evidence 与旧版本代码）
verify-*/

# 闭源商业层（billing / market / hosting / sync / meeting）
# 由独立私有仓库管理，绝不进公开仓库、绝不进公开 npm 包
pro/

# 自签证书与私钥（自己生成，绝不进仓库）
certs/
*.pem
!assets/**/*.pem

# 官方发布工具（本机下载的 exe，不进仓库）
.tools/

dist/
*.zip
