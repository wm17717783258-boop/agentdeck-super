# 依赖
node_modules/
pnpm-lock.yaml

# 打包产物
*.tgz
*.log

# 本地密钥（绝不提交）
.secrets/

# 内部资料（定价 / 变现 / 竞品 / 发布手册）：只留本地，不进开源仓库
internal/

# 运行时数据（每个用户自己的）
.relay-data/
.agentdeck/
.agentdeck-issuer/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 证据与临时
tmp/
*.tmp

# 自签证书与私钥（自己生成，绝不进仓库）
certs/
*.pem
!assets/**/*.pem
